generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                  String   @id @default(uuid())
  name                String
  users               User[]
  clients             Client[]
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("businesses")
}

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  role                String   @default("staff")
  business            Business @relation(fields: [businessId], references: [id])
  businessId          String
  createdAt           DateTime @default(now()) @map("created_at")

  // Link to Supabase Auth
  authId              String? @unique

  @@index([businessId])
  @@map("users")
}

model Client {
  id                  String   @id @default(uuid())
  name                String
  email               String?
  phone               String?
  business            Business @relation(fields: [businessId], references: [id])
  businessId          String
  leads               Lead[]
  followUps           FollowUp[]
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([businessId])
  @@map("clients")

}


model Lead {
  id                  String      @id @default(uuid())
  status              String      @default("new")
  notes               String?
  client              Client      @relation(fields: [clientId], references: [id])
  clientId            String
  business            Business    @relation(fields: [businessId], references: [id] )
  businessId          String
  createdAt           DateTime    @default(now())  @map("created_at")

  @@index([businessId,clientId])
  @@map("leads")

} 


model FollowUp {
  id                String        @id @default(uuid())
  notes             String
  dueDate           DateTime
  completed         Boolean
  client            Client        @relation(fields: [clientId],references: [id])
  clientId          String
  business          Business      @relation(fields: [businessId],references: [id])
  businessId        String
  createdAt         DateTime      @default(now()) @map("created_at")

  @@index([businessId,clientId])
  @@map("follow_ups")
  
}

