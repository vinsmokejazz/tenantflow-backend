generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

model Business {
  id           String     @id @default(uuid()) @db.Uuid
  name         String
  subscription String     @default("free")
  users        User[]
  clients      Client[]
  leads        Lead[]
  followUps    FollowUp[]
  analytics    Analytics[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("businesses")
  @@schema("public")
}

model User {
  id                String    @id @default(uuid()) @db.Uuid
  supabase_id       String    @unique @db.Uuid
  email             String    @unique
  password          String?   // Optional since Supabase handles auth
  name              String
  role              String    @default("staff")
  business          Business  @relation(fields: [businessId], references: [id])
  businessId        String    @map("business_id") @db.Uuid
  resetToken        String?
  resetTokenExpires DateTime?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("users")
  @@schema("public")
}

model Client {
  id         String     @id @default(uuid()) @db.Uuid
  name       String
  email      String?
  phone      String?
  business   Business   @relation(fields: [businessId], references: [id])
  businessId String     @map("business_id") @db.Uuid
  leads      Lead[]
  followUps  FollowUp[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("clients")
  @@schema("public")
}

model Lead {
  id         String   @id @default(uuid()) @db.Uuid
  status     String   @default("new")
  notes      String?
  client     Client   @relation(fields: [clientId], references: [id])
  clientId   String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id])
  businessId String   @map("business_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([businessId, clientId])
  @@map("leads")
  @@schema("public")
}

model FollowUp {
  id         String   @id @default(uuid()) @db.Uuid
  notes      String
  dueDate    DateTime
  completed  Boolean  @default(false)
  client     Client   @relation(fields: [clientId], references: [id])
  clientId   String   @db.Uuid
  business   Business @relation(fields: [businessId], references: [id])
  businessId String   @map("business_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([businessId, clientId])
  @@map("follow_ups")
  @@schema("public")
}

model Analytics {
  id         String   @id @default(uuid()) @db.Uuid
  business   Business @relation(fields: [businessId], references: [id])
  businessId String   @map("business_id") @db.Uuid
  date       DateTime
  metrics    Json
  aiInsights Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([businessId, date])
  @@map("analytics")
  @@schema("public")
}
