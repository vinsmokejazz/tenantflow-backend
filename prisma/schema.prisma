generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

model Business {
  id           String     @id @default(uuid())
  name         String
  subscription String     @default("free")
  users        User[]
  clients      Client[]
  leads        Lead[]
  followUps    FollowUp[]
  analytics    Analytics[]
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("businesses")
  @@schema("public")
}

model User {
  id              String    @id @default(uuid())
  supabase_id     String    @unique
  email           String    @unique
  password        String?   // Optional since Supabase handles auth
  name            String
  role            String    @default("staff")
  business        Business  @relation(fields: [businessId], references: [id])
  businessId      String    @map("business_id")
  resetToken      String?
  resetTokenExpires DateTime?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("users")
  @@schema("public")
}

model Client {
  id         String     @id @default(uuid())
  name       String
  email      String?
  phone      String?
  business   Business   @relation(fields: [businessId], references: [id])
  businessId String     @map("business_id")
  leads      Lead[]
  followUps  FollowUp[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("clients")
  @@schema("public")
}

model Lead {
  id         String   @id @default(uuid())
  status     String   @default("new")
  notes      String?
  client     Client   @relation(fields: [clientId], references: [id])
  clientId   String
  business   Business @relation(fields: [businessId], references: [id])
  businessId String   @map("business_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([businessId, clientId])
  @@map("leads")
  @@schema("public")
}

model FollowUp {
  id         String   @id @default(uuid())
  notes      String
  dueDate    DateTime
  completed  Boolean  @default(false)
  client     Client   @relation(fields: [clientId], references: [id])
  clientId   String
  business   Business @relation(fields: [businessId], references: [id])
  businessId String   @map("business_id")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([businessId, clientId])
  @@map("follow_ups")
  @@schema("public")
}

model Analytics {
  id         String   @id @default(uuid())
  business   Business @relation(fields: [businessId], references: [id])
  businessId String   @map("business_id")
  date       DateTime
  metrics    Json
  aiInsights Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([businessId, date])
  @@map("analytics")
  @@schema("public")
}
