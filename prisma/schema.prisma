generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  schemas    = ["public", "auth"]
}

model Business {
  id                    String     @id @default(uuid())
  name                  String
  users                 User[]
  clients               Client[]
  leads                 Lead[]
  followUps             FollowUp[]
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  @@map("businesses")
  @@schema("public")
}

model User {
  id                    String   @id @default(uuid())
  email                 String   @unique
  role                  String   @default("staff")
  business              Business @relation(fields: [businessId], references: [id])
  businessId            String
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  // link to Supabase Auth
  authId                String?  @unique

  @@index([businessId])
  @@map("users")
  @@schema("public")
}

model Client {
  id                      String    @id @default(uuid())
  name                    String
  email                   String?
  phone                   String?
  business                Business  @relation(fields: [businessId], references: [id])
  businessId              String
  leads                   Lead[]
  followUps               FollowUp[]
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@index([businessId])
  @@map("clients")
  @@schema("public")
}

model Lead {
  id                        String    @id @default(uuid())
  status                    String    @default("new")
  notes                     String?
  client                    Client    @relation(fields: [clientId], references: [id])
  clientId                  String
  business                  Business  @relation(fields: [businessId], references: [id])
  businessId                String
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")

  @@index([businessId, clientId])
  @@map("leads")
  @@schema("public")
}

model FollowUp {
  id                          String    @id @default(uuid())
  notes                       String
  dueDate                     DateTime
  completed                   Boolean   @default(false)
  client                      Client    @relation(fields: [clientId], references: [id])
  clientId                    String
  business                    Business  @relation(fields: [businessId], references: [id])
  businessId                  String
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  @@index([businessId, clientId])
  @@map("follow_ups")
  @@schema("public")
}
