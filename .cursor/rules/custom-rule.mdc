---
description: 
globs: 
alwaysApply: true
---
{
  "name": "Rename businessId to business_id",
  "description": "Update all businessId references to business_id across the codebase",
  "match": {
    "include": ["**/*.ts", "**/*.tsx", "**/*.js", "**/*.prisma"]
  },
  "type": "auto attached",
  "rewrite": [
    {
      "pattern": "\\bbusinessId\\b",
      "replacement": "business_id"
    },
    {
      "pattern": "\\bBusinessId\\b",
      "replacement": "Business_Id"
    },
    {
      "pattern": "\\.businessId\\b",
      "replacement": ".business_id"
    },
    {
      "pattern": "\\['businessId'\\]",
      "replacement": "['business_id']"
    },
    {
      "pattern": '\\"businessId\\"',
      "replacement": '"business_id"'
    },
    {
      "pattern": "businessId:",
      "replacement": "business_id:"
    },
    {
      "pattern": "businessId =",
      "replacement": "business_id ="
    },
    {
      "pattern": "businessId =>",
      "replacement": "business_id =>"
    }
  ]
}
