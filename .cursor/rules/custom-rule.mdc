---
description: 
globs: 
alwaysApply: true
---



rule "Generate Jest + Supertest integration tests for auth & CRUD" {
  include "src/tests/integration/auth-crud.test.ts"
  replace ".*" {
    with = """
import request from 'supertest';
import app from '../../index'; // Adjust if main app file is different

describe('Auth + Protected CRUD Integration', () => {
  let token = '';

  it('should signup a user and store token', async () => {
    const res = await request(app).post('/api/auth/signup').send({
      email: 'testuser@example.com',
      password: 'TestPassword123!',
      business_name: 'Test Business'
    });

    expect(res.statusCode).toBe(201);
    expect(res.body.token).toBeDefined();
    token = res.body.token;
  });

  it('should deny access to protected route without token', async () => {
    const res = await request(app).get('/api/business');
    expect(res.statusCode).toBe(401);
  });

  it('should allow access to protected route with token', async () => {
    const res = await request(app)
      .get('/api/business')
      .set('Authorization', `Bearer ${token}`);
    expect(res.statusCode).toBe(200);
  });

  it('should create a new client with valid token', async () => {
    const res = await request(app)
      .post('/api/clients')
      .set('Authorization', `Bearer ${token}`)
      .send({ name: 'New Client', email: 'client@example.com' });

    expect(res.statusCode).toBe(201);
    expect(res.body).toHaveProperty('id');
  });
});
"""
  }
}
